# Jusmin config - copy this file to ".env" and fill in your values.
#   Windows : copy .env.example .env
#   mac/Linux: cp .env.example .env
# The real ".env" is git-ignored, so it is safe to put secrets there.

# --- required ---------------------------------------------------------
# Gemini API key (free) - get one at https://aistudio.google.com
GEMINI_API_KEY=

# Model used by analyze_image (image understanding). Leave blank to use the
# default (gemini-3.5-flash-lite). Set this only if the default rejects images
# on your account, e.g. VISION_MODEL=gemini-3.5-flash
#VISION_MODEL=

# --- email (optional) -----------------------------------------------
# Fill these two if you want Jusmin to check / read / send Gmail.
# EMAIL_APP_PASSWORD is a 16-char Google "App Password"
#   from https://myaccount.google.com/apppasswords
#   (turn on 2-Step Verification first - this is NOT your normal Gmail password)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Name shown in the auto-signature at the bottom of every email Jusmin sends
# (leave blank to use the email address instead)
EMAIL_SENDER_NAME=

# --- email server (optional) --------------------------------------
# Defaults are Gmail. Uncomment and change only for a non-Gmail account.
#EMAIL_IMAP_HOST=imap.gmail.com
#EMAIL_SMTP_HOST=smtp.gmail.com
#EMAIL_SMTP_PORT=587
